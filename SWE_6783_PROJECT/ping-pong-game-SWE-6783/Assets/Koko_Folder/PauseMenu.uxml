<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Koko_Folder/menu-style.uss?fileID=7433441132597879392&amp;guid=4f93358af6c5a436d8d5cb80edc0a3a1&amp;type=3#menu-style"/>
    <ui:VisualElement name="Overlay" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0.8); justify-content: center; align-items: center; width: 100%; height: 100%; position: absolute; top: 0; right: 0; bottom: 0; left: 0; flex-shrink: 0;">
        <ui:VisualElement name="MenuContainer" style="width: 500px; padding: 20px; background-color: rgb(45, 45, 45); border-radius: 10px; border-width: 2px; border-color: rgb(255, 255, 255); height: auto; background-image: url(&quot;project://database/Assets/BackgroundImages/background_gradient.jpg?fileID=2800000&amp;guid=34ab1bf53c43b2b45846f41916e26450&amp;type=3#background_gradient&quot;);">
            <ui:Label text="PAUSED" name="MenuTitle" style="font-size: 40px; color: white; -webkit-unity-font-style: bold; unity-text-align: upper-center; margin-bottom: 20px; position: relative; width: 100%; height: 50px;"/>
            <ui:Button name="ResumeBtn" text="RESUME" class="menu-button" style="margin-bottom: 10px; height: 45px; width: 100%; font-size: 20px;"/>
            <ui:Button name="RestartBtn" text="RESTART" class="menu-button" style="margin-bottom: 10px; height: 45px; width: 100%; font-size: 20px;"/>
            <ui:Button name="ScoresBtn" text="SCORE HISTORY" class="menu-button" style="margin-bottom: 10px; height: 45px; width: 100%; font-size: 20px;"/>
            <ui:Button name="SettingsBtn" text="SETTING MENU" class="menu-button" style="margin-bottom: 10px; height: 45px; width: 100%; font-size: 20px;"/>
            <ui:Button name="MainMenuBtn" text="MAIN MENU" class="menu-button" style="height: 45px; background-color: rgb(180, 50, 50); width: 100%; font-size: 20px;"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
