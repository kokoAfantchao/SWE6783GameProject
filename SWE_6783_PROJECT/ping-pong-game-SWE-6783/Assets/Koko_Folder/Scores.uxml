<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Koko_Folder/menu-style.uss?fileID=7433441132597879392&amp;guid=4f93358af6c5a436d8d5cb80edc0a3a1&amp;type=3#menu-style"/>
    <ui:VisualElement name="Container" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0.8); justify-content: center; align-items: center; width: 100%; height: 100%; position: absolute; top: 0; right: 0; bottom: 0; left: 0; flex-shrink: 0;">
        <ui:VisualElement name="MenuContainer" style="width: 500px; padding: 20px; background-color: rgb(45, 45, 45); border-radius: 10px; border-width: 2px; border-color: rgb(255, 255, 255); height: auto; background-image: url(&quot;project://database/Assets/BackgroundImages/background_gradient.jpg?fileID=2800000&amp;guid=34ab1bf53c43b2b45846f41916e26450&amp;type=3#background_gradient&quot;);">
            <ui:Label text="PAUSED" name="MenuTitle" style="font-size: 40px; color: white; -webkit-unity-font-style: bold; unity-text-align: upper-center; margin-bottom: 20px; position: relative; width: 100%; height: 50px;"/>
            <ui:VisualElement name="Header" style="flex-direction: row; justify-content: space-between; border-bottom-width: 2px; border-bottom-color: rgb(255, 255, 255); margin-bottom: 10px; padding-bottom: 5px;">
                <ui:Label text="PLAYER" style="-webkit-unity-font-style: bold; color: rgb(200, 200, 200);"/>
                <ui:Label text="SCORE" style="-webkit-unity-font-style: bold; color: rgb(200, 200, 200);"/>
            </ui:VisualElement>
            <ui:ScrollView name="ScoreScrollView" style="flex-grow: 1;">
                <ui:VisualElement name="ScoreList" style="flex-grow: 1;"/>
            </ui:ScrollView>
            <ui:Button text="CLOSE HISTORY" name="CloseBtn" style="margin-top: 15px; height: auto; background-color: rgb(58, 120, 255); color: white; border-radius: 5px; width: auto; -unity-text-align: middle-center; white-space: nowrap; flex-basis: auto; flex-direction: column; left: 20%; position: absolute; bottom: 10px; right: 20%; top: auto; flex-grow: 5; opacity: 1; flex-shrink: 1; aspect-ratio: auto;"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
