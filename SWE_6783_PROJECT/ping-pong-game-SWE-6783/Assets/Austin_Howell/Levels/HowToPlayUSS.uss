.title {
    font-size: 64px;
    color: white;
    -unity-font-style: bold;
    margin-bottom: 20px;
}

.heading {
    font-size: 44px;
    color: rgb(255, 200, 0);
    margin-top: 15px;
    margin-bottom: 5px;
}

.body {
    font-size: 32px;
    color: rgb(200, 200, 200);
    white-space: normal;
    margin-left: 10px;
    margin-bottom: 10px;

}
.scrollBody{
    padding: 25px;
    display: flex;
    flex-direction: column;
    align-items: center;
    height: 100%;
}


.row{
    display: flex;
    flex-direction: row;
    align-items: center;
}

.iconUp {
    background-image: url("up-arrow.png");
    width: 32px;
    height: 32px;
}
.iconDown {
    background-image: url("up-arrow.png");
    width: 32px;
    height: 32px;
    rotate: 180deg;
}

.backBtn {
    width: 225px;
    height: 75px;
    margin-top: 20px;
    font-size: 32px;
    color: white;
    background-color: rgb(58, 58, 58);
    border-radius: 5px;
    align-self: center;
}